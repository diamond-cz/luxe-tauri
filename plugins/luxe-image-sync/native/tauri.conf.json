{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LUXE 图片联动",
  "version": "0.1.2",
  "identifier": "luxe.image.sync",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "LUXE 图片联动",
        "width": 520,
        "height": 220,
        "resizable": true,
        "visible": true
      }
    ],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'" }
  },
  "bundle": { "active": false }
}
