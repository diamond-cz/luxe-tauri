{
  "manifestVersion": 1,
  "apiVersion": 1,
  "id": "luxe.image-sync",
  "name": "LUXE 图片联动",
  "version": "0.1.4",
  "author": "LUXE",
  "description": "同步 HiViewer 焦点图片到 LUXE，在插件中控制 LUXE，并显示 LUXE 当前选择。",
  "entry": "main.js",
  "permissions": ["native.execute", "selection.read"],
  "commands": [
    { "id": "sync", "title": "打开 LUXE 图片联动", "handler": "native-view", "method": "view/open" },
    { "id": "update", "title": "同步当前图片", "handler": "native-view", "method": "viewer/update", "hidden": true }
  ],
  "contributions": [
    { "id": "sync", "kind": "image-viewer", "title": "LUXE 图片联动", "command": "sync" }
  ],
  "dataVersion": 1,
  "backend": {
    "executable": "bin/luxe-image-sync.exe",
    "target": "windows-x86_64",
    "transport": "stdio-jsonl"
  }
}
